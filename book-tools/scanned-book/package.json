{
  "name": "keeping-the-heart",
  "private": true,
  "type": "module",
  "description": "Keeping the Heart by John Flavel (American Tract Society text) — book build for books.freely.giving",
  "scripts": {
    "text": "python -I tools/fix.py && python -I tools/split.py",
    "build": "node tools/build.mjs",
    "pdf": "node tools/build.mjs --pdf",
    "compare": "python -I C:/code/books-freelygiv-ing/book-tools/shared/compare-page.py source/raw.md \"text/*.md\" -o dist/compare.html",
    "proof": "python -I C:/code/books-freelygiv-ing/book-tools/shared/proof-sample.py \"text/*.md\" -o check/read.md"
  },
  "devDependencies": {
    "@fontsource/crimson-pro": "^5.3.0",
    "cheerio": "^1.0.0",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "pagedjs": "^0.4.3",
    "puppeteer-core": "^23.11.1"
  }
}
