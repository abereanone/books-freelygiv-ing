---
import { bookAuthorSlug, bookSlugFromPath, personName, LANGUAGES } from '../lib/data.js';

interface Props {
  book: any;
  compact?: boolean;
  grid?: boolean;
  showAuthors?: boolean;
  showAddedDateTooltip?: boolean;
}

const { book, compact = false, grid = false, showAuthors = false, showAddedDateTooltip = false } = Astro.props;
const authorSlug = bookAuthorSlug(book);
const bookSlug   = bookSlugFromPath(book.path);
const href       = `/books/${authorSlug}/${bookSlug}/`;
const tags       = (book.tags || []).join(',');
const types      = (book.mediaTypes || []).map((m: any) => m.type).join(',');
const lang       = book.lang ?? 'en';
// A book not in English carries its language as a badge ("Español"), from `lang` in book.yaml.
const langBadge  = lang !== 'en' ? ((LANGUAGES as any)[lang]?.native ?? lang) : null;
const personListName = (person: any) => person.lastName ? `${person.lastName}, ${person.firstName}`.trim() : personName(person);
const addedDate = book.addedDate instanceof Date
  ? book.addedDate.toISOString().slice(0, 10)
  : book.addedDate;
const addedDateTooltip = showAddedDateTooltip && addedDate
  ? `Updated ${String(addedDate).replaceAll('-', '/')}`
  : undefined;
---

{grid ? (
  <div class="book-grid-item card card-hover position-relative" data-tags={tags} data-types={types} data-lang={lang} title={addedDateTooltip}>
    <div style="display:flex;align-items:center;gap:0.75rem;padding:0.5rem;">
      <img
        src={`${book.path}/${book.cover}`}
        class="rounded flex-shrink-0"
        style="max-height:80px;width:auto;"
        alt={`${book.title} cover`}
      />
      <div>
        <h6 class="mb-1 lh-sm">
          <a href={href} class="stretched-link text-decoration-none text-reset" lang={langBadge ? lang : undefined}>{book.title}</a>{(book.tags || []).map((tag: string) => (
            <span class={`badge tag-badge tag-${tag} ms-1`}>{tag}</span>
          ))}{langBadge && <span class="badge tag-badge lang-badge ms-1" lang={lang}>{langBadge}</span>}
        </h6>
        {showAuthors && book.authors?.[0] && (
          <div class="text-body-secondary small mb-1 card-authors">
            {book.authors.map((author: any, i: number) => (
              <span>{i > 0 ? ', ' : ''}{author.href ? <a href={author.href} class="text-reset">{personListName(author)}</a> : personListName(author)}</span>
            ))}
          </div>
        )}
        {book.year && (
          <small class="text-body-secondary">
            {book.year}{book.pages ? ` · ${book.pages} pages` : ''}
          </small>
        )}
      </div>
    </div>
  </div>
) : (
  <a href={href} class="list-group-item list-group-item-action card-hover text-decoration-none" data-tags={tags} data-lang={lang}>
    <div class="row g-0">
      <div class="col-auto">
        <img
          src={`${book.path}/${book.cover}`}
          class="rounded me-3"
          style={compact ? "max-height: 80px" : "max-height: 150px"}
          alt={`${book.title} cover`}
        />
      </div>
      <div class="col">
        <h5 class="mb-1">
          <span lang={langBadge ? lang : undefined}>{book.title}</span>{(book.tags || []).map((tag: string) => (
            <span class={`badge tag-badge tag-${tag}`}>{tag}</span>
          ))}{langBadge && <span class="badge tag-badge lang-badge" lang={lang}>{langBadge}</span>}
        </h5>
        {(!compact || showAuthors) && book.authors?.[0] && (
          <p class="mb-1">
            {book.authors.map((author: any, i: number) => (
              <span>{i > 0 ? ', ' : ''}{author.href ? <a
                href={author.href}
                class="text-reset"
                onclick="event.stopPropagation()"
              >{personName(author)}</a> : personName(author)}</span>
            ))}
          </p>
        )}
        {book.year && (
          <small class="text-body-secondary">
            {book.year}{book.pages ? ` · ${book.pages} pages` : ''}
          </small>
        )}
        {!compact && book.description && (
          <p class="book-description-preview text-body-secondary mb-0 mt-1">
            {book.description.split(' ').slice(0, 25).join(' ')}…
          </p>
        )}
      </div>
    </div>
  </a>
)}

<style is:global>
  /* The whole grid card opens the book (the title's stretched-link covers it). The author line
     sits above that cover so its names stay links to the person pages, but only the names
     catch taps: the empty part of the line passes them through to the book. */
  .book-grid-item { cursor: pointer; }
  .book-grid-item .card-authors { position: relative; z-index: 2; pointer-events: none; }
  .book-grid-item .card-authors a { pointer-events: auto; }
</style>

<script>
  // Backup for phone browsers that miss the stretched link: a tap anywhere on a grid card
  // that is not itself a link opens the book. Ctrl/Cmd-click opens it in a new tab.
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target || target.closest('a, button, input, label, select, textarea')) return;
    const link = target.closest('.book-grid-item')?.querySelector<HTMLAnchorElement>('a.stretched-link');
    if (!link) return;
    if (e.ctrlKey || e.metaKey) window.open(link.href, '_blank');
    else location.assign(link.href);
  });
</script>
