---
title: Library
layout: base.liquid
ogTitle: "Library"
ogDescription: "Browse the full collection of freely given books."
---

<h1>{{ title }}</h1>

{% comment %}Collect all unique tags from books{% endcomment %}
{% assign allTags = "" %}
{% for book in books %}
  {% for tag in book.tags %}
    {% unless allTags contains tag %}
      {% if allTags == "" %}
        {% assign allTags = tag %}
      {% else %}
        {% assign allTags = allTags | append: "," | append: tag %}
      {% endif %}
    {% endunless %}
  {% endfor %}
{% endfor %}
{% assign tagList = allTags | split: "," | sort %}

<div class="tag-filter mb-3" id="tagFilter">
  <div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="tagDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
      Filter by tag
    </button>
    <ul class="dropdown-menu" aria-labelledby="tagDropdown">
      {% for tag in tagList %}
      <li>
        <label class="dropdown-item d-flex align-items-center gap-2">
          <input type="checkbox" class="form-check-input mt-0 tag-checkbox" value="{{ tag }}">
          {{ tag | capitalize }}
        </label>
      </li>
      {% endfor %}
      <li><hr class="dropdown-divider"></li>
      <li>
        <button class="dropdown-item text-body-secondary tag-clear-btn" type="button">Clear filters</button>
      </li>
    </ul>
  </div>
  <span class="text-body-secondary ms-2 tag-filter-summary" id="tagFilterSummary"></span>
</div>

<ul class="nav nav-tabs mb-4" id="libraryTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="title-tab" data-bs-toggle="tab" data-bs-target="#by-title" type="button" role="tab" aria-controls="by-title" aria-selected="true">By Title</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="author-tab" data-bs-toggle="tab" data-bs-target="#by-author" type="button" role="tab" aria-controls="by-author" aria-selected="false">By Author</button>
  </li>
</ul>

<div class="tab-content" id="libraryTabContent">
  <!-- By Title Tab -->
  <div class="tab-pane fade show active" id="by-title" role="tabpanel" aria-labelledby="title-tab">
    {% assign sortedByTitle = books | sort: 'sortTitle' %}
    {% assign currentLetter = '' %}
    <div class="list-group">
      {%- for book in sortedByTitle -%}
        {% assign firstLetter = book.sortTitle | slice: 0 | upcase %}
        {% if firstLetter != currentLetter %}
          {% assign currentLetter = firstLetter %}
          <div class="list-group-item bg-body-secondary library-letter-heading">
            <strong><em>{{ currentLetter }}</em></strong>
          </div>
        {% endif %}
        {% include 'book-item.liquid', book: book %}
      {%- endfor %}
    </div>
  </div>

  <!-- By Author Tab -->
  <div class="tab-pane fade" id="by-author" role="tabpanel" aria-labelledby="author-tab">
    {% assign sortedByAuthor = books | sortByAuthor %}
    {% assign currentLetter = '' %}
    <div class="list-group">
      {%- for book in sortedByAuthor -%}
        {% assign firstLetter = book.authors[0].lastName | slice: 0 | upcase %}
        {% unless firstLetter %}{% continue %}{% endunless %}
        {% if firstLetter != currentLetter %}
          {% assign currentLetter = firstLetter %}
          <div class="list-group-item bg-body-secondary library-letter-heading">
            <strong><em>{{ currentLetter }}</em></strong>
          </div>
        {% endif %}
        {% include 'book-item.liquid', book: book %}
      {%- endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var checkboxes = document.querySelectorAll(".tag-checkbox");
    var clearBtn = document.querySelector(".tag-clear-btn");
    var summary = document.getElementById("tagFilterSummary");
    var bookItems = document.querySelectorAll("[data-tags]");
    var letterHeadings = document.querySelectorAll(".library-letter-heading");
    var dropdownBtn = document.getElementById("tagDropdown");

    function getSelectedTags() {
      var selected = [];
      checkboxes.forEach(function (cb) {
        if (cb.checked) selected.push(cb.value);
      });
      return selected;
    }

    function applyFilter() {
      var selected = getSelectedTags();

      // Update summary text
      if (selected.length === 0) {
        summary.textContent = "";
        dropdownBtn.textContent = "Filter by tag";
      } else {
        var labels = selected.map(function (t) {
          return t.charAt(0).toUpperCase() + t.slice(1);
        });
        summary.textContent = labels.join(", ");
        dropdownBtn.textContent = "Filtering (" + selected.length + ")";
      }

      // Show/hide books
      bookItems.forEach(function (item) {
        if (selected.length === 0) {
          item.style.display = "";
        } else {
          var tags = item.getAttribute("data-tags").split(",");
          var match = selected.some(function (s) { return tags.includes(s); });
          item.style.display = match ? "" : "none";
        }
      });

      // Hide empty letter headings
      letterHeadings.forEach(function (heading) {
        var next = heading.nextElementSibling;
        var hasVisible = false;
        while (next && !next.classList.contains("library-letter-heading")) {
          if (next.hasAttribute("data-tags") && next.style.display !== "none") {
            hasVisible = true;
            break;
          }
          next = next.nextElementSibling;
        }
        heading.style.display = hasVisible ? "" : "none";
      });
    }

    checkboxes.forEach(function (cb) {
      cb.addEventListener("change", applyFilter);
    });

    clearBtn.addEventListener("click", function () {
      checkboxes.forEach(function (cb) { cb.checked = false; });
      applyFilter();
    });
  });
</script>
