---
siteTitle: Freely Given Books
---

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <script>
      // Apply saved theme immediately to prevent flash
      (function() {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme) {
          document.documentElement.setAttribute('data-bs-theme', savedTheme);
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{% if ogDescription %}{{ ogDescription }}{% endif %}" />
    <title>{% if title %}{{ title }} - {% endif %}{{ siteTitle }}</title>

    {% if ogTitle %}
    <meta property="og:title" content="{{ ogTitle }}" />
    {% endif %}
    {% if ogDescription %}
    <meta property="og:description" content="{{ ogDescription }}" />
    {% endif %}
    <meta property="og:image" content="{% if ogImage %}{{ ogImage }}{% else %}{{ site.url }}/static/images/fgbooks-og.jpeg{% endif %}" />
    {% if ogImage %}
    <meta property="og:image:alt" content="{{ ogTitle }} cover" />
    {% endif %}
    {% if ogType %}
    <meta property="og:type" content="{{ ogType }}" />
    {% endif %}
    <meta property="og:site_name" content="{{ siteTitle }}" />

    <meta name="twitter:card" content="summary_large_image" />
    {% if ogTitle %}
    <meta name="twitter:title" content="{{ ogTitle }}" />
    {% endif %}
    {% if ogDescription %}
    <meta name="twitter:description" content="{{ ogDescription }}" />
    {% endif %}
    <meta name="twitter:image" content="{% if ogImage %}{{ ogImage }}{% else %}{{ site.url }}/static/images/fgbooks-og.jpeg{% endif %}" />

    <link href="/css/normalize.min.css" rel="stylesheet" />
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/custom.css" rel="stylesheet" />
    <link href="/css/colorToggle.css" rel="stylesheet" />
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script type="module" crossorigin src="https://collection.fetch.bible/enhance.js"></script>
  </head>
  <body>
    <nav class="navbar navbar-expand-md border-bottom mb-4">
      <div class="container">
        <a href="/" class="navbar-brand text-yellow">
          <h2 class="fs-4 mb-0">{{ siteTitle }}</h2>
        </a>
        <div class="d-flex align-items-center gap-2 d-md-none">
          <button class="btn btn-sm" id="themeBtnMobile">
            <img src="/static/images/light-mode.svg" />
          </button>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
        </div>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto gap-2 pt-3 pb-2 py-md-0">
            {% for item in site.navitems %}
            <li class="nav-item">
              <a href="{{ item.path }}" class="nav-link d-md-none px-2 py-2">{{ item.title }}</a>
              <a href="{{ item.path }}" class="btn btn-outline-primary btn-sm d-none d-md-inline-block">{{ item.title }}</a>
            </li>
            {% endfor %}
          </ul>
          <button class="btn btn-sm d-none d-md-flex align-items-center ms-2" id="themeBtn">
            <img src="/static/images/light-mode.svg" />
          </button>
        </div>
      </div>
    </nav>

    <div class="container">
      <div class="row">
        <div class="col-0 col-lg-2"></div>
        <div class="col-12 col-lg-8">{{ content }}</div>
        <div class="col-0 col-lg-2"></div>
      </div>
    </div>
    <div class="container">
      <footer class="py-3 my-4">
        <p class="text-center text-body-secondary">{{ siteTitle }}</p>
      </footer>
    </div>
  </body>
  <script src="/js/themeToggle.js"></script>
</html>
