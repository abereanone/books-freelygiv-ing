<a href="/books/{% if book.authors[0] %}{{ book.authors[0].slug }}/{% endif %}{{ book.title | slugify }}/" class="list-group-item list-group-item-action card-hover text-decoration-none" data-tags="{% for tag in book.tags %}{{ tag }}{% unless forloop.last %},{% endunless %}{% endfor %}">
  <div class="row g-0">
    <div class="col-auto">
      <img
        src="{{ book.path }}/{{ book.cover }}"
        class="rounded me-3"
        style="max-height: 150px"
        alt="{{ book.title }} cover"
      />
    </div>
    <div class="col">
      <h5 class="mb-1">
        {{ book.title }}
        {% for tag in book.tags %}
        <span class="badge tag-badge tag-{{ tag }}">{{ tag }}</span>
        {% endfor %}
      </h5>
      {% if book.authors[0] %}
      <p class="mb-1">{{ book.authors | authorNames }}</p>
      {% endif %}
      {% if book.year %}
      <small class="text-body-secondary">{{ book.year }}</small>
      {% endif %}
      {% if book.description %}
      <p class="book-description-preview text-body-secondary mb-0 mt-1">{{ book.description | truncatewords: 25 }}</p>
      {% endif %}
    </div>
  </div>
</a>
