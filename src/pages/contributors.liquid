---
title: Contributors
layout: base.liquid
permalink: /contributors/
---

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Home</a></li>
    <li class="breadcrumb-item active" aria-current="page">Contributors</li>
  </ol>
</nav>

<h1>{{ title }}</h1>

{% assign sortedContributors = contributors | sort: 'lastName' %}

<div class="row row-cols-2 row-cols-md-3 g-3">
  {% for contributor in sortedContributors %}
  <div class="col">
    <a href="/contributors/{{ contributor.slug }}/" class="card h-100 text-decoration-none text-center">
      {% if contributor.photo != "" %}
      <img
        src="{{ contributor.photo }}"
        class="card-img-top p-3 rounded-circle"
        style="aspect-ratio: 1; object-fit: cover;"
        alt="{{ contributor.firstName }} {{ contributor.lastName }}"
      />
      {% endif %}
      <div class="card-body">
        <h5 class="card-title">{{ contributor.firstName }} {{ contributor.lastName }}</h5>
      </div>
    </a>
  </div>
  {% endfor %}
</div>
