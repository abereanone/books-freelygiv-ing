---
pagination:
  data: contributors
  size: 1
  alias: contributor
permalink: "/contributors/{{ contributor.slug }}/"
layout: base.liquid
eleventyComputed:
  title: "{{ contributor.firstName }} {{ contributor.lastName }}"
---

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Home</a></li>
    <li class="breadcrumb-item"><a href="/contributors">Contributors</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ contributor.firstName }} {{ contributor.lastName }}</li>
  </ol>
</nav>

<div class="mb-4">
  {% if contributor.photo != "" %}
  <img
    src="{{ contributor.photo }}"
    class="rounded mb-3"
    style="max-width: 200px;"
    alt="{{ contributor.firstName }} {{ contributor.lastName }}"
  />
  {% endif %}

  <h1>{{ contributor.firstName }} {{ contributor.lastName }}</h1>

  {% if contributor.description != "" %}
  <p class="lead">{{ contributor.description | linkify | newline_to_br }}</p>
  {% endif %}

  {% if contributor.donateUrl != "" %}
  <a href="{{ contributor.donateUrl }}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Donate</a>
  {% endif %}
</div>

<h2 class="mb-3">Books Added</h2>

{% assign sortedBooks = books | sort: 'sortTitle' %}

<div class="list-group">
  {% for book in sortedBooks %}
    {% if book.contributors contains contributor.slug %}
      {% include 'book-item.liquid', book: book %}
    {% endif %}
  {% endfor %}
</div>
