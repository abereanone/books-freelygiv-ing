---
import Base from '../../layouts/Base.astro';
import QuoteGallery from '../../components/QuoteGallery.astro';
import { getQuotes, getQuoteTopics, quoteImage } from '../../lib/data.js';

const quotes = getQuotes();
const topics = getQuoteTopics() as Record<string, { label: string }>;
const used = new Set(quotes.flatMap((q: any) => q.topics));
const topicLinks = Object.entries(topics).filter(([k]) => used.has(k));

// Quote of the day: picked in the browser by today's date, from the featured quotes
// (all of them until some are featured), so it changes daily without a rebuild.
const pool = (quotes.some((q: any) => q.featured) ? quotes.filter((q: any) => q.featured) : quotes)
  .map((q: any) => ({ id: q.id, img: quoteImage(q.id, q.tone, 'full'), text: q.text, by: q.authorName, book: q.bookTitle }));
const first = pool[0];
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const desc = 'Free quote images from the books on Freely Given Books: download them, share them, and read the books they come from.';
---

<Base title="Quote Cards" ogTitle="Quote Cards" ogDescription={desc} ogImage={first ? (first.img.startsWith('http') ? first.img : `${siteUrl}${first.img}`) : undefined}>
  <h1>Quote Cards</h1>
  <p class="lead qc-lead">Images of the best lines from the books in this library. Download them, share them, and every one links back to its free book.</p>

  {first && (
    <section class="qotd" aria-labelledby="qotdHeading">
      <a class="qotd-card" id="qotdLink" href={`/quotes/${first.id}/`}>
        <img id="qotdImg" src={first.img} alt={`${first.text} (${first.by})`} width="1080" height="1080" />
      </a>
      <div class="qotd-text">
        <h2 id="qotdHeading" class="h6 text-uppercase text-body-secondary qotd-label">Quote of the day</h2>
        <p class="qotd-quote" id="qotdText">{first.text}</p>
        <p class="text-body-secondary mb-3" id="qotdBy">{first.by}, <i>{first.book}</i></p>
        <a class="btn btn-primary btn-sm" id="qotdOpen" href={`/quotes/${first.id}/`}>Share or download</a>
      </div>
    </section>
  )}

  <QuoteGallery />

  <h2 class="h5 mt-5">Topics</h2>
  <p class="qc-topics">
    {topicLinks.map(([k, v]) => <a class="btn btn-outline-secondary btn-sm" href={`/quotes/topics/${k}/`}>{v.label}</a>)}
  </p>
  <p class="small text-body-secondary mt-4">Backgrounds are public-domain paintings from the Art Institute of Chicago's open-access collection.</p>
</Base>

<script type="application/json" id="qotdData" set:html={JSON.stringify(pool)}></script>
<script>
  const pool = JSON.parse(document.getElementById('qotdData')!.textContent!);
  if (pool.length) {
    const d = new Date();
    const day = Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 864e5);
    const q = pool[day % pool.length];
    const href = `/quotes/${q.id}/`;
    (document.getElementById('qotdLink') as HTMLAnchorElement).href = href;
    (document.getElementById('qotdOpen') as HTMLAnchorElement).href = href;
    const img = document.getElementById('qotdImg') as HTMLImageElement;
    img.src = q.img; img.alt = `${q.text} (${q.by})`;
    document.getElementById('qotdText')!.textContent = q.text;
    const by = document.getElementById('qotdBy')!;
    by.textContent = `${q.by}, `;
    const i = document.createElement('i'); i.textContent = q.book; by.append(i);
  }
</script>

<style>
  .qc-lead { max-width: 46rem; }
  .qotd { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 1.25rem; align-items: center;
          padding: 1rem; margin: 1.25rem 0 2rem; border: 1px solid var(--bs-border-color); border-radius: .5rem; }
  @media (max-width: 575px) { .qotd { grid-template-columns: 1fr; } }
  .qotd-card { display: block; border-radius: .4rem; overflow: hidden; }
  .qotd-card img { width: 100%; height: auto; display: block; }
  .qotd-label { letter-spacing: .08em; }
  .qotd-quote { font-family: Georgia, 'Times New Roman', serif; font-size: 1.35rem; line-height: 1.35; text-wrap: balance; margin-bottom: .5rem; }
  .qc-topics { display: flex; flex-wrap: wrap; gap: .4rem; }
</style>
