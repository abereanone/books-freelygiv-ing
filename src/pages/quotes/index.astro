---
import Base from '../../layouts/Base.astro';
import QuoteGallery from '../../components/QuoteGallery.astro';
import { getQuotes, getQuoteTopics, quoteImage } from '../../lib/data.js';

const quotes = getQuotes();
const topics = getQuoteTopics() as Record<string, { label: string }>;
const used = new Set(quotes.flatMap((q: any) => q.topics));
const topicLinks = Object.entries(topics).filter(([k]) => used.has(k));

// The page's share preview uses a featured quote's card (or the first one).
const pool = (quotes.some((q: any) => q.featured) ? quotes.filter((q: any) => q.featured) : quotes)
  .map((q: any) => ({ id: q.id, img: quoteImage(q.id, q.tone, 'full'), text: q.text, by: q.authorName, book: q.bookTitle }));
const first = pool[0];
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const desc = 'Free quote images from the books on Freely Given Books: download them, share them, and read the books they come from.';
---

<Base title="Quote Cards" ogTitle="Quote Cards" ogDescription={desc} ogImage={first ? (first.img.startsWith('http') ? first.img : `${siteUrl}${first.img}`) : undefined}>
  <h1>Quote Cards</h1>

  <QuoteGallery />

  <h2 class="h5 mt-5">Topics</h2>
  <p class="qc-topics">
    {topicLinks.map(([k, v]) => <a class="btn btn-outline-secondary btn-sm" href={`/quotes/topics/${k}/`}>{v.label}</a>)}
  </p>
  <p class="small text-body-secondary mt-4">Backgrounds are public-domain paintings from the Art Institute of Chicago's open-access collection.</p>
</Base>



<style>
  .qc-topics { display: flex; flex-wrap: wrap; gap: .4rem; }
</style>
