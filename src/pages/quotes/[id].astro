---
// /quotes/<id>/: a quote card in its own look. The page itself is src/components/QuotePage.astro.
import QuotePage from '../../components/QuotePage.astro';
import { getQuotes } from '../../lib/data.js';

export function getStaticPaths() {
  const all = getQuotes();
  // prev/next in site order (wrapping), for swiping when the visitor didn't come from the gallery.
  return all.map((q: any, i: number) => ({ params: { id: q.id }, props: { q, all,
    prev: all[(i - 1 + all.length) % all.length].id, next: all[(i + 1) % all.length].id } }));
}
---
<QuotePage {...(Astro.props as any)} />
