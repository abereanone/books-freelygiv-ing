---
import Base from '../layouts/Base.astro';
import BookItem from '../components/BookItem.astro';
import { getBooks, getBookAuthorPairs, LANGUAGES } from '../lib/data.js';

const books = getBooks().sort((a, b) => a.sortTitle.localeCompare(b.sortTitle));
const bookAuthorPairs = getBookAuthorPairs();

const allTags = [...new Set(books.flatMap(b => b.tags || []))].sort();

const typeConfig: Record<string, { label: string; cls: string }> = {
  htmlBook:   { label: 'Read Online', cls: 'btn-success' },
  htmlBookEs: { label: 'Leer en línea', cls: 'btn-outline-success' },
  pdfBook:    { label: 'PDF',         cls: 'btn-danger'  },
  eBook:      { label: 'eBook',       cls: 'btn-primary' },
  mobi:       { label: 'Mobi',        cls: 'btn-info'    },
  printBook:  { label: 'Print',       cls: 'btn-warning' },
  printReady: { label: 'Print Ready', cls: 'btn-secondary'},
  wordDoc:    { label: 'Word',        cls: 'btn-word'     },
  audiobook:  { label: 'Audiobook',   cls: 'btn-audiobook'},
};

const allTypes = [...new Set(books.flatMap(b => (b.mediaTypes || []).map((m: any) => m.type)))]
  .filter(t => typeConfig[t])
  .sort((a, b) => Object.keys(typeConfig).indexOf(a) - Object.keys(typeConfig).indexOf(b));

// One button per language that has a book, in LANGUAGES order; none while every book is English.
const allLangs = [...new Set(books.map((b: any) => b.lang))]
  .sort((a, b) => Object.keys(LANGUAGES).indexOf(a) - Object.keys(LANGUAGES).indexOf(b));
const langLabel = (lang: string) => (LANGUAGES as any)[lang]?.filter ?? lang;
const langName  = (lang: string) => (LANGUAGES as any)[lang]?.name ?? lang;

function groupByLetter<T>(items: T[], getLetter: (item: T) => string): { letter: string; items: T[] }[] {
  const map = new Map<string, T[]>();
  for (const item of items) {
    const letter = getLetter(item) || '#';
    if (!map.has(letter)) map.set(letter, []);
    map.get(letter)!.push(item);
  }
  return [...map.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([letter, items]) => ({ letter, items }));
}

const byTitle  = groupByLetter(books, b => b.sortTitle?.[0]?.toUpperCase() ?? '#');
const dateValue = (d: any) => d instanceof Date ? d.getTime() : new Date(`${d}T00:00:00`).getTime() || 0;
const byRecent = [...books].sort((a: any, b: any) => dateValue(b.addedDate) - dateValue(a.addedDate));
const byAuthor = groupByLetter(bookAuthorPairs, ({ person }) => person.lastName?.[0]?.toUpperCase() ?? '#');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogImage = `${siteUrl}/static/og/library.jpg`;
---

<Base ogImage={ogImage} title="Library" ogTitle="Library" ogDescription="Browse the full collection of freely given books.">
  <h1>Library</h1>

  <div class="d-flex flex-wrap gap-2 mb-2" id="typeFilter">
    {allLangs.length > 1 && allLangs.map(lang => (
      <button
        class="btn btn-sm btn-lang lang-filter-btn"
        data-lang={lang}
        data-name={langName(lang)}
        lang={lang}
        type="button"
        aria-pressed="false"
      >{langLabel(lang)}</button>
    ))}
    {allLangs.length > 1 && <span class="filter-divider" aria-hidden="true"></span>}
    {allTypes.map(type => (
      <button
        class={`btn btn-sm ${typeConfig[type].cls} type-filter-btn`}
        data-type={type}
        type="button"
      >{typeConfig[type].label}</button>
    ))}
  </div>
  <p class="text-body-secondary small mb-3" id="typeFilterStatus" style="display:none;">
    Showing only books <strong id="typeFilterLabel"></strong> &mdash;
    <button class="btn btn-link btn-sm p-0 text-body-secondary type-clear-btn" type="button">show all</button>
  </p>

  <div class="tag-filter mb-3" id="tagFilter">
    <div class="dropdown">
      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="tagDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
        Filter by tag
      </button>
      <ul class="dropdown-menu" aria-labelledby="tagDropdown">
        {allTags.map(tag => (
          <li>
            <label class="dropdown-item d-flex align-items-center gap-2">
              <input type="checkbox" class="form-check-input mt-0 tag-checkbox" value={tag} />
              {tag.charAt(0).toUpperCase() + tag.slice(1)}
            </label>
          </li>
        ))}
        <li><hr class="dropdown-divider" /></li>
        <li>
          <button class="dropdown-item text-body-secondary tag-clear-btn" type="button">Clear filters</button>
        </li>
      </ul>
    </div>
    <span class="text-body-secondary ms-2 tag-filter-summary" id="tagFilterSummary"></span>
  </div>

  <ul class="nav nav-tabs mb-4" id="libraryTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="title-tab" data-bs-toggle="tab" data-bs-target="#by-title" type="button" role="tab" aria-controls="by-title" aria-selected="true">By Title</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="author-tab" data-bs-toggle="tab" data-bs-target="#by-author" type="button" role="tab" aria-controls="by-author" aria-selected="false">By Author</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="recent-tab" data-bs-toggle="tab" data-bs-target="#by-recent" type="button" role="tab" aria-controls="by-recent" aria-selected="false">Recently Added</button>
    </li>
  </ul>

  <div class="tab-content" id="libraryTabContent">
    <!-- By Title -->
    <div class="tab-pane fade show active" id="by-title" role="tabpanel" aria-labelledby="title-tab">
      {byTitle.map(({ letter, items }) => (
        <div class="letter-section mb-4" data-letter={letter}>
          <h5 class="library-letter-heading bg-body-secondary rounded px-3 py-1 mb-3">
            <em>{letter}</em>
          </h5>
          <div class="row row-cols-1 row-cols-md-3 g-3">
            {items.map((book: any) => (
              <div class="col">
                <BookItem book={book} grid showAuthors />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- By Author (includes contributors) -->
    <div class="tab-pane fade" id="by-author" role="tabpanel" aria-labelledby="author-tab">
      {byAuthor.map(({ letter, items }) => (
        <div class="letter-section mb-4" data-letter={letter}>
          <h5 class="library-letter-heading bg-body-secondary rounded px-3 py-1 mb-3">
            <em>{letter}</em>
          </h5>
          <div class="row row-cols-1 row-cols-md-3 g-3">
            {items.map(({ book }: any) => (
              <div class="col">
                <BookItem book={book} grid showAuthors />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Recently Added (newest first, by addedDate) -->
    <div class="tab-pane fade" id="by-recent" role="tabpanel" aria-labelledby="recent-tab">
      <div class="letter-section mb-4">
        <div class="row row-cols-1 row-cols-md-3 g-3">
          {byRecent.map((book: any) => (
            <div class="col">
              <BookItem book={book} grid showAuthors showAddedDateTooltip />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const checkboxes   = document.querySelectorAll('.tag-checkbox');
    const clearBtn     = document.querySelector('.tag-clear-btn');
    const summary      = document.getElementById('tagFilterSummary');
    const dropdownBtn  = document.getElementById('tagDropdown');
    const typeButtons    = document.querySelectorAll('.type-filter-btn');
    const typeStatus     = document.getElementById('typeFilterStatus') as HTMLElement;
    const typeLabel      = document.getElementById('typeFilterLabel') as HTMLElement;
    const typeClearBtns  = document.querySelectorAll('.type-clear-btn');

    const langButtons    = document.querySelectorAll('.lang-filter-btn');

    let activeType: string | null = null;
    let activeLang: string | null = null;

    function getSelectedTags(): string[] {
      return [...checkboxes].filter(cb => (cb as HTMLInputElement).checked).map(cb => (cb as HTMLInputElement).value);
    }

    // "Showing only books in Spanish, available as PDF — show all"
    function updateStatus() {
      const parts: string[] = [];
      if (activeLang) {
        const btn = document.querySelector(`.lang-filter-btn[data-lang="${activeLang}"]`) as HTMLElement | null;
        parts.push(`in ${btn?.dataset.name ?? activeLang}`);
      }
      if (activeType) {
        const label = (document.querySelector(`.type-filter-btn[data-type="${activeType}"]`) as HTMLElement)?.textContent?.trim() ?? activeType;
        parts.push(`available as ${label}`);
      }
      typeLabel.textContent = parts.join(', ');
      typeStatus.style.display = parts.length ? '' : 'none';
    }

    function setActiveType(type: string | null) {
      activeType = type;
      typeButtons.forEach(btn => {
        const el = btn as HTMLElement;
        const isActive = el.dataset.type === type;
        btn.classList.toggle('type-btn-active', isActive);
        (btn as HTMLElement).style.opacity = type === null || isActive ? '1' : '0.35';
      });
      updateStatus();
    }

    // The language filter is kept in the URL (?lang=es) so a Spanish reader can be sent
    // straight to the Spanish books: books.freely.giving/library/?lang=es
    function setActiveLang(lang: string | null, updateUrl = true) {
      activeLang = lang;
      langButtons.forEach(btn => {
        const el = btn as HTMLElement;
        const isActive = el.dataset.lang === lang;
        el.classList.toggle('active', isActive);
        el.setAttribute('aria-pressed', String(isActive));
      });
      if (updateUrl) {
        const url = new URL(location.href);
        if (lang) url.searchParams.set('lang', lang); else url.searchParams.delete('lang');
        history.replaceState(null, '', url);
      }
      updateStatus();
    }

    function applyFilter() {
      const selectedTags = getSelectedTags();

      if (selectedTags.length === 0) {
        summary!.textContent = '';
        dropdownBtn!.textContent = 'Filter by tag';
      } else {
        summary!.textContent = selectedTags.map(t => t[0].toUpperCase() + t.slice(1)).join(', ');
        dropdownBtn!.textContent = `Filtering (${selectedTags.length})`;
      }

      document.querySelectorAll('.letter-section').forEach(section => {
        const bookItems = section.querySelectorAll('[data-tags]');
        let hasVisible = false;
        bookItems.forEach(item => {
          const el = item as HTMLElement;
          const col = el.closest('.col') as HTMLElement;
          const tags  = el.getAttribute('data-tags')?.split(',').filter(Boolean) ?? [];
          const types = el.getAttribute('data-types')?.split(',').filter(Boolean) ?? [];

          const tagOk  = selectedTags.length === 0 || selectedTags.some(t => tags.includes(t));
          const typeOk = activeType === null || types.includes(activeType);
          const langOk = activeLang === null || el.dataset.lang === activeLang;

          const visible = tagOk && typeOk && langOk;
          col.style.display = visible ? '' : 'none';
          if (visible) hasVisible = true;
        });
        (section as HTMLElement).style.display = hasVisible ? '' : 'none';
      });
    }

    typeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = (btn as HTMLElement).dataset.type!;
        setActiveType(activeType === type ? null : type);
        applyFilter();
      });
    });

    langButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = (btn as HTMLElement).dataset.lang!;
        setActiveLang(activeLang === lang ? null : lang);
        applyFilter();
      });
    });

    checkboxes.forEach(cb => cb.addEventListener('change', applyFilter));
    clearBtn?.addEventListener('click', () => {
      checkboxes.forEach(cb => (cb as HTMLInputElement).checked = false);
      setActiveType(null);
      setActiveLang(null);
      applyFilter();
    });
    typeClearBtns.forEach(btn => btn.addEventListener('click', () => {
      setActiveType(null);
      setActiveLang(null);
      applyFilter();
    }));

    const startLang = new URLSearchParams(location.search).get('lang');
    if (startLang && document.querySelector(`.lang-filter-btn[data-lang="${startLang}"]`)) {
      setActiveLang(startLang, false);
      applyFilter();
    }
  });
</script>
