---
import Base from '../../layouts/Base.astro';
import BookItem from '../../components/BookItem.astro';
import { getContributors, getBooks, linkify, newlineToBr, personPhotos } from '../../lib/data.js';

export function getStaticPaths() {
  return getContributors().map(contributor => ({
    params: { slug: contributor.slug },
    props: { contributor },
  }));
}

const { contributor } = Astro.props;

const books = getBooks()
  .filter((book: any) => (book.contributors || []).includes(contributor.slug))
  .sort((a: any, b: any) => a.sortTitle.localeCompare(b.sortTitle));

const fullName = `${contributor.firstName} ${contributor.lastName}`;
const descHtml = newlineToBr(linkify(contributor.description ?? ''));
const photos = personPhotos(contributor);
---

<Base title={fullName} ogTitle={fullName} ogDescription={contributor.description}>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/contributors">Contributors</a></li>
      <li class="breadcrumb-item active" aria-current="page">{fullName}</li>
    </ol>
  </nav>

  <div class="mb-4 clearfix">
    {photos.length > 0 && (
      <div class="float-md-end ms-md-4 mb-3 text-center text-md-start">
        {photos.map((photo: string, index: number) => (
          <img
            src={photo}
            class="rounded"
            style="width: 180px; max-width: 100%; aspect-ratio: 1; object-fit: cover;"
            alt={photos.length === 1 ? fullName : `${fullName} photo ${index + 1}`}
          />
        ))}
      </div>
    )}
    <h1>{fullName}</h1>
    {contributor.description && <div set:html={descHtml} />}
    {contributor.donateUrl && (
      <a href={contributor.donateUrl} class="btn btn-primary mt-2" target="_blank" rel="noopener noreferrer">Donate</a>
    )}
  </div>

  <h2 class="mb-3">Books Added</h2>
  <div class="row row-cols-1 row-cols-md-2 g-3">
    {books.map((book: any) => (
      <div class="col">
        <BookItem book={book} grid />
      </div>
    ))}
  </div>
</Base>
