---
import Base from '../../layouts/Base.astro';
import { getContributors } from '../../lib/data.js';

const contributors = getContributors().sort((a, b) => a.lastName.localeCompare(b.lastName));
---

<Base title="Contributors" ogTitle="Contributors" ogDescription="Meet the people who have contributed to this site.">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">Contributors</li>
    </ol>
  </nav>

  <h1>Contributors</h1>

  <div class="row row-cols-2 row-cols-md-3 g-3">
    {contributors.map(contributor => (
      <div class="col">
        <a href={`/contributors/${contributor.slug}/`} class="card h-100 text-decoration-none text-center">
          {contributor.photo && (
            <img
              src={contributor.photo}
              class="card-img-top p-3 rounded-circle"
              style="aspect-ratio: 1; object-fit: cover;"
              alt={`${contributor.firstName} ${contributor.lastName}`}
            />
          )}
          <div class="card-body">
            <h5 class="card-title">{contributor.firstName} {contributor.lastName}</h5>
          </div>
        </a>
      </div>
    ))}
  </div>
</Base>
