---
import Base from '../../../layouts/Base.astro';
import { getBooks, authorNames, linkify, newlineToBr, bookSlugFromPath } from '../../../lib/data.js';

export function getStaticPaths() {
  return getBooks().map((book: any) => ({
    params: {
      authorSlug: book.authors?.[0]?.slug ?? 'unknown',
      bookSlug:   bookSlugFromPath(book.path),
    },
    props: { book },
  }));
}

const { book } = Astro.props;
const descHtml  = newlineToBr(linkify(book.description ?? ''));
const siteUrl   = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogImage   = `${siteUrl}${book.path}/${book.cover}`;

const btnClass: Record<string, string> = {
  htmlBook:   'btn-success',
  pdfBook:    'btn-danger',
  eBook:      'btn-primary',
  mobi:       'btn-info',
  printBook:  'btn-warning',
  printReady: 'btn-secondary',
  audiobook:  'btn-secondary',
};
---

<Base
  title={book.title}
  ogTitle={book.title}
  ogDescription={`${book.title}${book.authors?.[0] ? ' by ' + authorNames(book.authors) : ''}`}
  ogImage={ogImage}
  ogType="book"
>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      {book.authors?.[0] ? (
        <>
          <li class="breadcrumb-item"><a href="/authors">Authors</a></li>
          {book.authors.map((author: any) => (
            <li class="breadcrumb-item">
              <a href={`/authors/${author.slug}/`}>{author.firstName} {author.lastName}</a>
            </li>
          ))}
        </>
      ) : (
        <li class="breadcrumb-item"><a href="/library">Library</a></li>
      )}
      <li class="breadcrumb-item active" aria-current="page">{book.title}</li>
    </ol>
  </nav>

  <article class="book-page">
    <div class="mb-4 clearfix">
      {book.cover && (
        <div class="float-md-start me-md-4 mb-3 text-center text-md-start">
          <div class="shadow rounded" style="display: inline-block; max-width: 220px; line-height: 0;">
            <img
              src={`${book.path}/${book.cover}`}
              class="rounded"
              style="width: 100%; height: auto; display: block;"
              alt={`${book.title} cover`}
            />
          </div>
        </div>
      )}

      <h1 class="mb-1">
        {book.title}
        {book.authors?.[0] && (
          <span class="fs-5 fw-normal text-body-secondary ms-2">by {book.authors.map((author: any, i: number) => (
              <>
                {i > 0 && ', '}
                <a href={`/authors/${author.slug}/`}>{author.firstName} {author.lastName}</a>
              </>
            ))}
          </span>
        )}
      </h1>

      <p class="text-body-secondary mb-3">
        {[
          book.year,
          book.pages && `${book.pages} pages`,
          book.license,
        ].filter(Boolean).join(' · ')}
      </p>

      {book.description && (
        <div class="book-description mb-4">
          <h3>Description</h3>
          <div set:html={descHtml} />
        </div>
      )}

      <div class="book-formats">
        <h3 class="mb-3">Available Formats</h3>
          <div class="d-grid gap-2 d-md-flex flex-wrap">
            {(book.mediaTypes || []).map((item: any) =>
              (item.sources || []).map((source: any) => (
                <a
                  class={`btn ${btnClass[item.type] ?? 'btn-primary'}`}
                  href={source.url}
                  target="_blank" rel="noopener noreferrer"
                >
                  {item.type === 'printBook' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-book me-2" viewBox="0 0 16 16">
                      <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783"/>
                    </svg>
                  )}
                  {item.type === 'eBook' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-tablet me-2" viewBox="0 0 16 16">
                      <path d="M12 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/>
                      <path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
                    </svg>
                  )}
                  {item.type === 'pdfBook' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-file-pdf me-2" viewBox="0 0 16 16">
                      <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1"/>
                      <path d="M4.603 12.087a.8.8 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.7 7.7 0 0 1 1.482-.645 20 20 0 0 0 1.062-2.227 7.3 7.3 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.187-.012.395-.047.614-.084.51-.27 1.134-.52 1.794a11 11 0 0 0 .98 1.686 5.8 5.8 0 0 1 1.334.05c.364.065.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.86.86 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.7 5.7 0 0 1-.911-.95 11.6 11.6 0 0 0-1.997.406 11.3 11.3 0 0 1-1.021 1.51c-.29.35-.608.655-.926.787a.8.8 0 0 1-.58.029m1.379-1.901q-.25.115-.459.238c-.328.194-.541.383-.647.547-.094.145-.096.25-.04.361q.016.032.026.044l.035-.012c.137-.056.355-.235.635-.572a8 8 0 0 0 .45-.606m1.64-1.33a13 13 0 0 1 1.01-.193 12 12 0 0 1-.51-.858 21 21 0 0 1-.5 1.05zm2.446.45q.226.244.435.41c.24.19.407.253.498.256a.1.1 0 0 0 .07-.015.3.3 0 0 0 .094-.125.44.44 0 0 0 .059-.2.1.1 0 0 0-.026-.063c-.052-.062-.2-.152-.518-.209a4 4 0 0 0-.612-.053zM8.078 5.8a7 7 0 0 0 .2-.828q.046-.282.038-.465a.6.6 0 0 0-.032-.198.5.5 0 0 0-.145.04c-.087.035-.158.106-.196.283-.04.192-.03.469.046.822q.036.167.09.346z"/>
                    </svg>
                  )}
                  {item.type === 'mobi' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-phone me-2" viewBox="0 0 16 16">
                      <path d="M11 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM5 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/>
                      <path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
                    </svg>
                  )}
                  {item.type === 'printReady' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-file-zip me-2" viewBox="0 0 16 16">
                      <path d="M6.5 7.5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v.938l.4 1.599a1 1 0 0 1-.416 1.074l-.93.62a1 1 0 0 1-1.109 0l-.93-.62a1 1 0 0 1-.415-1.074l.4-1.599zm2 0h-1v.938a1 1 0 0 1-.03.243l-.4 1.598.93.62.93-.62-.4-1.598a1 1 0 0 1-.03-.243z"/>
                      <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zm5.5-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H8v1h-.5zM8 3V2h-.5V1H8a1 1 0 0 0 0 2m0 1v1h.5V4zm0 2v1h.5V6zM7.5 8V7H8v1z"/>
                    </svg>
                  )}
                  {item.type === 'htmlBook' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye me-2" viewBox="0 0 16 16">
                      <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                      <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                    </svg>
                  )}
                  {item.type === 'audiobook' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-headphones me-2" viewBox="0 0 16 16">
                      <path d="M8 3a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8a6 6 0 1 1 12 0v5a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1V8a5 5 0 0 0-5-5"/>
                    </svg>
                  )}
                  {(() => {
                    const label = item.label ?? item.type;
                    return item.sources.length > 1 ? `${label} (${source.name})` : label;
                  })()}
                </a>
              ))
            )}
          </div>
        </div>
    </div>

    <div class="mt-5">
      <a href="/library" class="btn btn-outline-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-2" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>
        Back to Library
      </a>
    </div>
  </article>
</Base>
