---
import Base from '../../../layouts/Base.astro';
import FormatIcon from '../../../components/FormatIcon.astro';
import ShareButton from '../../../components/ShareButton.astro';
import CreditNames from '../../../components/CreditNames.astro';
import { ROLES, LANGUAGES, getBooks, authorNames, linkify, newlineToBr, bookAuthorSlug, bookSlugFromPath, bookCredits } from '../../../lib/data.js';

export function getStaticPaths() {
  return getBooks().map((book: any) => ({
    params: {
      authorSlug: bookAuthorSlug(book),
      bookSlug:   bookSlugFromPath(book.path),
    },
    props: { book },
  }));
}

const { book } = Astro.props;
const authorCredits   = bookCredits(book, 'author');
const preparers       = bookCredits(book, 'preparer');
// Book credits below the byline: "with contributions by …", "foreword by …", "translated by …".
const secondaryLines  = ROLES
  .filter(role => role.key === 'contributor' || role.key === 'foreword' || role.key === 'translator')
  .map(role => ({ role, credits: bookCredits(book, role.key) }))
  .filter(line => line.credits.length);
const descHtml  = newlineToBr(linkify(book.description ?? ''));
const siteUrl   = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogSlug    = bookSlugFromPath(book.path);
const ogImage   = `${siteUrl}/static/og/book-${ogSlug}.jpg`;
const shareTitle = `${book.title}${book.authors?.[0] ? ' by ' + authorNames(book.authors) : ''}`;
// The page chrome is English; only the book's own title and description carry its language.
const bookLang  = book.lang && book.lang !== 'en' ? book.lang : undefined;

const btnClass: Record<string, string> = {
  htmlBook:   'btn-success',
  htmlBookEs: 'btn-outline-success',
  whatsNew:   'btn-whats-new',
  pdfBook:    'btn-danger',
  eBook:      'btn-primary',
  mobi:       'btn-info',
  printBook:  'btn-warning',
  printReady: 'btn-secondary',
  wordDoc:    'btn-word',
  audiobook:  'btn-audiobook',
};
// Optional extra cover images (book.yaml: backCover, spine), shown in a viewer when the cover is clicked.
const views = [
  book.cover && { label: 'Front', src: `${book.path}/${book.cover}` },
  book.backCover && { label: 'Back', src: `${book.path}/${book.backCover}` },
  book.spine && { label: 'Spine', src: `${book.path}/${book.spine}` },
].filter(Boolean) as { label: string; src: string }[];
---

<Base
  lang={book.lang}
  title={book.title}
  ogTitle={book.title}
  ogDescription={shareTitle}
  ogImage={ogImage}
  ogImageAlt={`${book.title} cover`}
  ogType="book"
>
  <article class="book-page">
    <div class="mb-4 clearfix">
      {book.cover && (
        <div class="float-md-start me-md-4 mb-3 text-center text-md-start">
          {views.length > 1 ? (
            <button type="button" class="cover-open shadow rounded" id="cover-open" aria-label={`View ${book.title}: ${views.map(v => v.label.toLowerCase()).join(', ')}`}>
              <img
                src={`${book.path}/${book.cover}`}
                class="rounded"
                style="width: 100%; height: auto; display: block;"
                alt={`${book.title} cover`}
              />
              <span class="cover-hint">{views.map(v => v.label).join(' · ')}</span>
            </button>
          ) : (
            <div class="shadow rounded" style="display: inline-block; max-width: 220px; line-height: 0;">
              <img
                src={`${book.path}/${book.cover}`}
                class="rounded"
                style="width: 100%; height: auto; display: block;"
                alt={`${book.title} cover`}
              />
            </div>
          )}
        </div>
      )}

      <h1 class="mb-1">
        <span lang={bookLang}>{book.title}</span>
        {authorCredits.length > 0 && (
          <span class="fs-5 fw-normal text-body-secondary ms-2">by <CreditNames credits={authorCredits} /></span>
        )}
      </h1>

      {secondaryLines.map(({ role, credits }) => (
        <p class="text-body-secondary mb-1">{role.byline} <CreditNames credits={credits} /></p>
      ))}

      <p class="text-body-secondary mb-3">
        {[
          book.year,
          book.pages && `${book.pages} pages`,
          book.license,
        ].filter(Boolean).join(' · ')}
      </p>

      {book.editions?.length > 0 && (
        <p class="book-editions mb-3">
          {book.editions.map((ed: any, i: number) => (
            <span>{i > 0 && ' · '}Also available in {LANGUAGES[ed.lang]?.name ?? ed.lang}: <a href={ed.href} lang={ed.lang !== 'en' ? ed.lang : undefined}><em>{ed.title}</em></a></span>
          ))}
        </p>
      )}

      {book.description && (
        <div class="book-description mb-4">
          <h3>Description</h3>
          <div lang={bookLang} set:html={descHtml} />
        </div>
      )}

      <div class="book-formats">
        <h3 class="mb-3">Available Formats</h3>
        <div class="d-grid gap-2 d-md-flex flex-wrap">
          {(book.mediaTypes || []).map((item: any) => {
            const cls     = btnClass[item.type] ?? 'btn-primary';
            const label   = item.label ?? item.type;
            const sources = item.sources || [];

            if (sources.length === 1) {
              return (
                <a class={`btn ${cls}`} href={sources[0].url} target="_blank" rel="noopener noreferrer">
                  <FormatIcon type={item.type} />{label}
                </a>
              );
            }

            return (
              <div class="dropdown format-dropdown">
                <button class={`btn ${cls} dropdown-toggle`} type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <FormatIcon type={item.type} />{label}
                </button>
                <ul class="dropdown-menu">
                  {sources.map((source: any) => (
                    <li>
                      <a class="dropdown-item" href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
          <ShareButton title={shareTitle} iconSize={20} />
        </div>
      </div>
    </div>

    {preparers.length > 0 && (
      <div class="book-edition mt-4">
        <h3>About this edition</h3>
        <p class="mb-0">Prepared by <CreditNames credits={preparers} />.</p>
      </div>
    )}

    <div class="mt-5">
      <a href="/library" class="btn btn-outline-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-2" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>
        Back to Library
      </a>
    </div>
  </article>

<style>
  /* Hover opens the menu, but only where hovering is real. Touch devices have no
     hover state, so a hover-only menu would never open for them; the Bootstrap
     click/keyboard behaviour stays in place underneath for touch and keyboards. */
  .format-dropdown > .btn { width: 100%; }

  @media (min-width: 768px) {
    .format-dropdown > .btn { width: auto; }
  }

  @media (hover: hover) and (pointer: fine) {
    .format-dropdown:hover > .dropdown-menu {
      display: block;
      margin-top: 0; /* no gap, or the menu closes as the pointer crosses it */
    }
  }
</style>
{views.length > 1 && (
  <dialog id="cover-dialog" class="cover-dialog" aria-label={`${book.title} covers`}>
    <div class="cover-bar">
      {views.map((v, n) => <button type="button" class={`cover-tab${n === 0 ? ' active' : ''}`} data-src={v.src} data-label={v.label}>{v.label}</button>)}
      <button type="button" class="cover-close" aria-label="Close">✕</button>
    </div>
    <img id="cover-view" src={views[0].src} alt={`${book.title}, front`} />
  </dialog>
)}
</Base>

<style is:global>
  .cover-open { display: inline-block; max-width: 220px; line-height: 0; padding: 0; border: 0; background: none; cursor: zoom-in; position: relative; }
  .cover-hint { position: absolute; left: 0; right: 0; bottom: 0; line-height: 1.2; padding: .35rem .25rem; font-size: .75rem; color: #fff; background: rgba(0,0,0,.6); border-radius: 0 0 .375rem .375rem; }
  .cover-dialog { border: 0; padding: .75rem; max-width: 94vw; min-width: min(92vw, 460px); background: var(--bs-body-bg); color: var(--bs-body-color); border-radius: .5rem; text-align: center; }
  .cover-dialog::backdrop { background: rgba(0,0,0,.75); }
  .cover-dialog img { display: block; margin: .6rem auto 0; max-height: 78vh; max-width: 100%; width: auto; height: auto; }
  .cover-bar { display: flex; gap: .4rem; justify-content: center; align-items: center; }
  .cover-tab, .cover-close { border: 1px solid var(--bs-border-color); background: transparent; color: inherit; border-radius: .375rem; padding: .25rem .8rem; cursor: pointer; }
  .cover-tab.active { background: var(--bs-primary); border-color: var(--bs-primary); color: #fff; }
  .cover-close { margin-left: auto; }
</style>
<script>
  const dlg = document.getElementById('cover-dialog') as HTMLDialogElement | null;
  const view = document.getElementById('cover-view') as HTMLImageElement | null;
  if (dlg && view) {
    document.getElementById('cover-open')?.addEventListener('click', () => dlg.showModal());
    dlg.querySelectorAll<HTMLButtonElement>('.cover-tab').forEach((b) => b.addEventListener('click', () => {
      dlg.querySelectorAll('.cover-tab').forEach((t) => t.classList.remove('active'));
      b.classList.add('active'); view.src = b.dataset.src!; view.alt = b.dataset.label!;
    }));
    dlg.querySelector('.cover-close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
