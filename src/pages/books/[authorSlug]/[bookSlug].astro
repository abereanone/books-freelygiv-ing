---
import Base from '../../../layouts/Base.astro';
import FormatIcon from '../../../components/FormatIcon.astro';
import ShareButton from '../../../components/ShareButton.astro';
import CreditNames from '../../../components/CreditNames.astro';
import { ROLES, getBooks, authorNames, linkify, newlineToBr, bookAuthorSlug, bookSlugFromPath, bookCredits } from '../../../lib/data.js';

export function getStaticPaths() {
  return getBooks().map((book: any) => ({
    params: {
      authorSlug: bookAuthorSlug(book),
      bookSlug:   bookSlugFromPath(book.path),
    },
    props: { book },
  }));
}

const { book } = Astro.props;
const authorCredits   = bookCredits(book, 'author');
const preparers       = bookCredits(book, 'preparer');
// Book credits below the byline: "with contributions by …", "foreword by …".
const secondaryLines  = ROLES
  .filter(role => role.key === 'contributor' || role.key === 'foreword')
  .map(role => ({ role, credits: bookCredits(book, role.key) }))
  .filter(line => line.credits.length);
const descHtml  = newlineToBr(linkify(book.description ?? ''));
const siteUrl   = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogSlug    = bookSlugFromPath(book.path);
const ogImage   = `${siteUrl}/static/og/book-${ogSlug}.jpg`;
const shareTitle = `${book.title}${book.authors?.[0] ? ' by ' + authorNames(book.authors) : ''}`;

const btnClass: Record<string, string> = {
  htmlBook:   'btn-success',
  htmlBookEs: 'btn-outline-success',
  pdfBook:    'btn-danger',
  eBook:      'btn-primary',
  mobi:       'btn-info',
  printBook:  'btn-warning',
  printReady: 'btn-secondary',
  wordDoc:    'btn-word',
  audiobook:  'btn-audiobook',
};
---

<Base
  title={book.title}
  ogTitle={book.title}
  ogDescription={shareTitle}
  ogImage={ogImage}
  ogImageAlt={`${book.title} cover`}
  ogType="book"
>
  <article class="book-page">
    <div class="mb-4 clearfix">
      {book.cover && (
        <div class="float-md-start me-md-4 mb-3 text-center text-md-start">
          <div class="shadow rounded" style="display: inline-block; max-width: 220px; line-height: 0;">
            <img
              src={`${book.path}/${book.cover}`}
              class="rounded"
              style="width: 100%; height: auto; display: block;"
              alt={`${book.title} cover`}
            />
          </div>
        </div>
      )}

      <h1 class="mb-1">
        {book.title}
        {authorCredits.length > 0 && (
          <span class="fs-5 fw-normal text-body-secondary ms-2">by <CreditNames credits={authorCredits} /></span>
        )}
      </h1>

      {secondaryLines.map(({ role, credits }) => (
        <p class="text-body-secondary mb-1">{role.byline} <CreditNames credits={credits} /></p>
      ))}

      <p class="text-body-secondary mb-3">
        {[
          book.year,
          book.pages && `${book.pages} pages`,
          book.license,
        ].filter(Boolean).join(' · ')}
      </p>

      {book.description && (
        <div class="book-description mb-4">
          <h3>Description</h3>
          <div set:html={descHtml} />
        </div>
      )}

      <div class="book-formats">
        <h3 class="mb-3">Available Formats</h3>
        <div class="d-grid gap-2 d-md-flex flex-wrap">
          {(book.mediaTypes || []).map((item: any) => {
            const cls     = btnClass[item.type] ?? 'btn-primary';
            const label   = item.label ?? item.type;
            const sources = item.sources || [];

            if (sources.length === 1) {
              return (
                <a class={`btn ${cls}`} href={sources[0].url} target="_blank" rel="noopener noreferrer">
                  <FormatIcon type={item.type} />{label}
                </a>
              );
            }

            return (
              <div class="dropdown format-dropdown">
                <button class={`btn ${cls} dropdown-toggle`} type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <FormatIcon type={item.type} />{label}
                </button>
                <ul class="dropdown-menu">
                  {sources.map((source: any) => (
                    <li>
                      <a class="dropdown-item" href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
          <ShareButton title={shareTitle} iconSize={20} />
        </div>
      </div>
    </div>

    {preparers.length > 0 && (
      <div class="book-edition mt-4">
        <h3>About this edition</h3>
        <p class="mb-0">Prepared by <CreditNames credits={preparers} />.</p>
      </div>
    )}

    <div class="mt-5">
      <a href="/library" class="btn btn-outline-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-2" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>
        Back to Library
      </a>
    </div>
  </article>

<style>
  /* Hover opens the menu, but only where hovering is real. Touch devices have no
     hover state, so a hover-only menu would never open for them; the Bootstrap
     click/keyboard behaviour stays in place underneath for touch and keyboards. */
  .format-dropdown > .btn { width: 100%; }

  @media (min-width: 768px) {
    .format-dropdown > .btn { width: auto; }
  }

  @media (hover: hover) and (pointer: fine) {
    .format-dropdown:hover > .dropdown-menu {
      display: block;
      margin-top: 0; /* no gap, or the menu closes as the pointer crosses it */
    }
  }
</style>
</Base>
