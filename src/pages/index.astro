---
import Base from '../layouts/Base.astro';
import { bookAuthorSlug, bookSlugFromPath, getBooks, getPeopleWithRole, personAvatar, personName, LANGUAGES } from '../lib/data.js';

function dateValue(date: any): number {
  if (!date) return 0;
  if (date instanceof Date) return date.getTime();
  return new Date(`${date}T00:00:00`).getTime() || 0;
}

// Newest first. Each book carries its URL and the small cover copy build-og.js makes.
const books = getBooks()
  .sort((a: any, b: any) => dateValue(b.addedDate) - dateValue(a.addedDate))
  .map((book: any) => {
    const slug = bookSlugFromPath(book.path);
    return {
      ...book,
      href: `/books/${bookAuthorSlug(book)}/${slug}/`,
      thumb: `/static/thumbs/${slug}.webp`,
      byline: (book.authors || []).map((a: any) => personName(a)).join(', '),
      langName: book.lang !== 'en' ? ((LANGUAGES as any)[book.lang]?.native ?? book.lang) : null,
    };
  });

// Every visible book is reachable, including one with no author.
const randomBookUrls = books.map((book: any) => book.href);

// The cover wall: dealt round-robin into rows so each row mixes old and new.
const ROWS = 3;
const wallRows: any[][] = Array.from({ length: ROWS }, () => []);
books.forEach((book: any, i: number) => wallRows[i % ROWS].push(book));

const recent = books.slice(0, 12);

// Authors with a photo, most books first.
const bookCount = new Map<string, number>();
for (const book of books) for (const a of book.authors || []) bookCount.set(a.slug, (bookCount.get(a.slug) ?? 0) + 1);
const authors = getPeopleWithRole('author')
  .filter((p: any) => p.slug !== 'anonymous' && personAvatar(p))
  .map((p: any) => ({ ...p, avatar: personAvatar(p), count: bookCount.get(p.slug) ?? 0 }))
  .sort((a: any, b: any) => b.count - a.count || (a.lastName ?? '').localeCompare(b.lastName ?? ''));

const links = [
  { title: 'Library',        path: '/library' },
  { title: 'En español',     path: '/library?lang=es' },
  { title: 'Recently Added', path: '/recently-added' },
  { title: 'People',         path: '/people' },
  { title: 'About',          path: '/about' },
  { title: 'Contact',        path: '/contact' },
];
---

<Base>
  <section class="hero">
    <div class="hero-text">
      <p class="hero-eyebrow">{books.length} free books · Read online, PDF, EPUB</p>
      <h1 class="hero-title">Freely Given Books</h1>
      <p class="hero-lead">
        Puritan classics and modern works, free for the body of Christ.
      </p>
      <div class="hero-actions">
        <a href="/library" class="btn btn-warning btn-lg fw-semibold">Browse the library</a>
        <a
          id="randomBookLink"
          href="/library"
          class="btn btn-outline-secondary btn-lg random-book-btn"
          data-book-urls={JSON.stringify(randomBookUrls)}
        >Random book</a>
      </div>
    </div>

    <div class="wall">
      {wallRows.map((row, r) => (
        <div class={`wall-row wall-row-${r}`}>
          {[0, 1].map(copy => row.map((book: any) => (
            <a
              href={book.href}
              class="wall-cover"
              title={book.title}
              aria-hidden={copy ? 'true' : undefined}
              tabindex={copy ? -1 : undefined}
            >
              <img src={book.thumb} alt={copy ? '' : book.title} width="100" height="150" loading={r === 2 ? 'lazy' : 'eager'} decoding="async" />
            </a>
          )))}
        </div>
      ))}
    </div>
  </section>

  <section class="home-section">
    <div class="section-head">
      <h2>Recently added</h2>
      <a href="/recently-added">See all →</a>
    </div>
    <div class="shelf">
      {recent.map((book: any) => (
        <a href={book.href} class="shelf-book">
          <span class="shelf-cover">
            <img src={book.thumb} alt="" width="120" height="180" loading="lazy" decoding="async" />
            {book.langName && <span class="shelf-lang" lang={book.lang}>{book.langName}</span>}
          </span>
          <span class="shelf-title" lang={book.langName ? book.lang : undefined}>{book.title}</span>
          {book.byline && <span class="shelf-author">{book.byline}</span>}
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <div class="section-head">
      <h2>Authors</h2>
      <a href="/people/?filter=authors">All authors →</a>
    </div>
    <div class="faces">
      {authors.map((person: any) => (
        <a href={`/people/${person.slug}/`} class="face">
          <img src={person.avatar} alt="" width="96" height="96" loading="lazy" decoding="async" />
          <span class="face-name">{personName(person)}</span>
          <span class="face-count">{person.count} {person.count === 1 ? 'book' : 'books'}</span>
        </a>
      ))}
    </div>
  </section>

  <nav class="home-links" aria-label="More">
    {links.map(link => <a href={link.path} class="btn btn-outline-secondary btn-sm rounded-pill px-3">{link.title}</a>)}
  </nav>

  <!-- entry-content: bible-tooltips.js only scans article / .entry-content for references -->
  <section class="mission entry-content">
    <blockquote>
      <p>
        Wisdom from the Holy Spirit is something freely given to believers (1 Cor. 2:12), and Jesus
        told us that we should freely give, just as we have freely received (Matt. 10:8).
      </p>
      <p>
        We desire to obey this command from Christ and freely give to the body of Christ, just as we have
        freely received.
      </p>
      <footer>— Courtney Hicks &amp; Michael Coughlin</footer>
    </blockquote>
    <p class="mission-note text-body-secondary">
      The books on this website are a blend of books that we have formatted from the original sources
      into readable ebooks and books by modern authors. In some cases, we've set up links for you to
      be able to quickly order a print copy. You are also free to shop around and print any book on
      the site yourself.
    </p>
    <p class="mission-note text-body-secondary">
      Our desire is to make these books as easy to access as we can for the body of Christ, that we
      may grow together and that our love may abound in knowledge and all discernment. (Phil. 1:9,
      2 Pet. 3:18, Col. 1:10).
    </p>
  </section>
</Base>

<style>
  /* ── hero: text beside a drifting wall of covers (stacked on phones) ─────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: -0.5rem;
    border: 1px solid var(--bs-border-color);
    border-radius: 1rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 0% 0%, color-mix(in srgb, var(--my-yellow-text) 16%, transparent), transparent 60%),
      var(--bs-tertiary-bg);
  }
  .hero-text {
    order: 2;
    padding: 1.25rem 1.25rem 1.5rem;
    text-align: center;
  }
  .hero-eyebrow {
    margin-bottom: 0.4rem;
    color: var(--my-yellow-text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero-title {
    margin-bottom: 0.5rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 8vw, 3.6rem);
    font-weight: 700;
    line-height: 1.05;
  }
  .hero-lead {
    margin: 0 auto 1.25rem;
    max-width: 28rem;
    color: var(--bs-secondary-color);
    font-size: 1.1rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .hero-actions .btn { flex: 1 1 10rem; max-width: 16rem; }
  .random-book-btn {
    --bs-btn-color: var(--bs-emphasis-color);
    --bs-btn-border-color: var(--bs-emphasis-color);
    --bs-btn-hover-color: var(--bs-body-bg);
    --bs-btn-hover-bg: var(--bs-emphasis-color);
    --bs-btn-hover-border-color: var(--bs-emphasis-color);
    font-weight: 600;
  }

  /* The edge fades are two overlays rather than a mask-image: a mask over moving content
     makes the browser repaint the whole wall every frame, which stutters (seen in Edge). */
  .wall {
    order: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem 0 0.25rem;
    overflow: hidden;
    contain: paint;
  }
  .wall::before, .wall::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 8%;
    pointer-events: none;
  }
  .wall::before { left: 0;  background: linear-gradient(90deg, var(--bs-tertiary-bg), transparent); }
  .wall::after  { right: 0; background: linear-gradient(-90deg, var(--bs-tertiary-bg), transparent); }
  .wall-row {
    display: flex;
    gap: 0.6rem;
    width: max-content;
    animation: drift 140s linear infinite;
    will-change: transform;
  }
  .wall-row-1 { animation-direction: reverse; animation-duration: 170s; }
  .wall-row-2 { animation-duration: 155s; display: none; }
  .wall:hover .wall-row, .wall.is-offscreen .wall-row { animation-play-state: paused; }
  .wall-cover { flex: none; display: block; border-radius: 4px; transition: transform 0.2s ease; }
  .wall-cover:hover, .wall-cover:focus-visible { transform: translateY(-4px) scale(1.04); }
  .wall-cover img {
    display: block;
    width: 76px;
    height: 114px;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
  }
  @keyframes drift { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-50%, 0, 0); } }

  @media (min-width: 992px) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      margin-top: 0;
    }
    .hero-text { order: 0; padding: 3rem 1rem 3rem 3rem; text-align: left; }
    .hero-lead { margin-left: 0; font-size: 1.25rem; }
    .hero-actions { justify-content: flex-start; }
    .hero-actions .btn { flex: 0 0 auto; }
    .wall { order: 0; padding: 1.5rem 0; gap: 0.9rem; }
    .wall-row { gap: 0.9rem; }
    .wall-row-2 { display: flex; }
    .wall-cover img { width: 100px; height: 150px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall::before, .wall::after { display: none; }
    .wall-row { animation: none; overflow-x: auto; max-width: 100%; padding: 0 1rem 4px; }
  }

  /* ── sections ───────────────────────────────────────────────────────────── */
  .home-section { margin-top: 2.5rem; }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .section-head h2 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.6rem;
    font-weight: 700;
  }
  .section-head a { white-space: nowrap; text-decoration: none; font-weight: 600; }

  /* Phones: one swipeable row running to the screen edges. Desktop: a grid. */
  .shelf, .faces {
    display: flex;
    gap: 0.9rem;
    margin-inline: calc(var(--bs-gutter-x, 1.5rem) * -0.5);
    padding: 0.25rem calc(var(--bs-gutter-x, 1.5rem) * 0.5) 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: calc(var(--bs-gutter-x, 1.5rem) * 0.5);
    scrollbar-width: none;
  }
  .shelf::-webkit-scrollbar, .faces::-webkit-scrollbar { display: none; }

  .shelf-book {
    flex: 0 0 8rem;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    color: inherit;
    text-decoration: none;
  }
  .shelf-cover { position: relative; display: block; margin-bottom: 0.5rem; }
  .shelf-cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .shelf-book:hover .shelf-cover img {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
  }
  .shelf-lang {
    position: absolute;
    top: 6px;
    left: 6px;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: #8a2a3c;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 600;
  }
  .shelf-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .shelf-author {
    margin-top: 0.15rem;
    overflow: hidden;
    color: var(--bs-secondary-color);
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .face {
    flex: 0 0 5.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    scroll-snap-align: start;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }
  .face img {
    width: 5rem;
    height: 5rem;
    margin-bottom: 0.4rem;
    border: 3px solid var(--bs-body-bg);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--my-yellow-text) 70%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .face:hover img { transform: scale(1.06); box-shadow: 0 0 0 3px var(--my-yellow-text); }
  .face-name { font-size: 0.82rem; font-weight: 600; line-height: 1.2; }
  .face-count { color: var(--bs-secondary-color); font-size: 0.72rem; }

  @media (min-width: 768px) {
    .shelf, .faces {
      display: grid;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
    .shelf { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem 1.25rem; }
    .faces { grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr)); gap: 1.25rem 0.75rem; }
    .face img { width: 6rem; height: 6rem; }
    .face-name { font-size: 0.9rem; }
  }
  @media (min-width: 992px) {
    .shelf { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }

  /* ── links and mission ──────────────────────────────────────────────────── */
  .home-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  .mission { max-width: 720px; margin: 3rem auto 0; }
  .mission blockquote {
    margin: 0 0 1.5rem;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 4px solid var(--my-yellow-text);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.2rem;
    line-height: 1.55;
  }
  .mission blockquote p { margin-bottom: 0.75rem; }
  .mission blockquote footer {
    color: var(--bs-secondary-color);
    font-family: var(--bs-body-font-family);
    font-size: 0.95rem;
  }
  .mission-note { font-size: 0.95rem; }
</style>

<script>
  // Stop the cover wall while it is scrolled out of view, so it costs nothing below the fold.
  const wall = document.querySelector('.wall');
  if (wall && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => wall.classList.toggle('is-offscreen', !entry.isIntersecting)).observe(wall);
  }

  document.getElementById('randomBookLink')?.addEventListener('click', event => {
    const link = event.currentTarget as HTMLAnchorElement;
    const bookUrls = JSON.parse(link.dataset.bookUrls || '[]');
    if (!bookUrls.length) return;

    event.preventDefault();
    window.location.href = bookUrls[Math.floor(Math.random() * bookUrls.length)];
  });
</script>
