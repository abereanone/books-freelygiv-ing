---
import Base from '../../layouts/Base.astro';
import BookItem from '../../components/BookItem.astro';
import { getAuthors, getBooks, linkify, newlineToBr, personPhotos } from '../../lib/data.js';

export function getStaticPaths() {
  return getAuthors().map(author => ({ params: { slug: author.slug }, props: { author } }));
}

const { author } = Astro.props;

const books = getBooks()
  .filter(book => {
    const authorSlugs = (book.authors || []).map((a: any) => a.slug);
    return authorSlugs.includes(author.slug) || (book.contributors || []).includes(author.slug);
  })
  .sort((a: any, b: any) => a.sortTitle.localeCompare(b.sortTitle));

const fullName = `${author.firstName} ${author.lastName}`;
const descHtml = newlineToBr(linkify(author.description ?? ''));
const photos = personPhotos(author);
---

<Base title={fullName} ogTitle={fullName} ogDescription={author.description}>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/authors">Authors</a></li>
      <li class="breadcrumb-item active" aria-current="page">{fullName}</li>
    </ol>
  </nav>

  <div class="mb-4 clearfix">
    {photos.length > 0 && (
      <div class="float-md-end ms-md-4 mb-3 text-center text-md-start">
        {photos.map((photo: string, index: number) => (
          <img
            src={photo}
            class="rounded"
            style="width: 180px; max-width: 100%; aspect-ratio: 1; object-fit: cover;"
            alt={photos.length === 1 ? fullName : `${fullName} photo ${index + 1}`}
          />
        ))}
      </div>
    )}
    <h1>{fullName}</h1>
    {author.description && <div set:html={descHtml} />}
    {author.donateUrl && (
      <a href={author.donateUrl} class="btn btn-primary mt-2" target="_blank" rel="noopener noreferrer">Donate</a>
    )}
  </div>

  <h2 class="mb-3">Books</h2>
  <div class="row row-cols-1 row-cols-md-2 g-3">
    {books.map((book: any) => (
      <div class="col">
        <BookItem book={book} grid />
      </div>
    ))}
  </div>
</Base>
