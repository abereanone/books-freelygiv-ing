---
import Base from '../../layouts/Base.astro';
import { getAuthors, personPhotos } from '../../lib/data.js';

const authors = getAuthors().sort((a, b) => a.lastName.localeCompare(b.lastName));
---

<Base title="Authors" ogTitle="Authors" ogDescription="Explore the authors whose works are featured on this site.">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">Authors</li>
    </ol>
  </nav>

  <h1>Authors</h1>

  <div class="row row-cols-2 row-cols-md-3 g-3">
    {authors.map(author => {
      const photo = personPhotos(author, 1)[0];
      return (
        <div class="col">
          <a href={`/authors/${author.slug}/`} class="card h-100 text-decoration-none text-center">
            {photo && (
              <img
                src={photo}
                class="card-img-top p-3 rounded-circle"
                style="aspect-ratio: 1; object-fit: cover;"
                alt={`${author.firstName} ${author.lastName}`}
              />
            )}
            <div class="card-body">
              <h5 class="card-title">{author.firstName} {author.lastName}</h5>
            </div>
          </a>
        </div>
      );
    })}
  </div>
</Base>
